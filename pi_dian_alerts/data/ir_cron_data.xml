<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record forcecreate="True" id="ir_cron_check_resolution_alerts" model="ir.cron">
            <field name="name">DIAN: Verificar alertas de resoluciones</field>
            <field name="model_id" ref="l10n_co_edi_jorels.model_l10n_co_edi_jorels_resolution"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_resolution_alerts()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=11, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
        </record>

        <record forcecreate="True" id="ir_cron_check_draft_invoices" model="ir.cron">
            <field name="name">DIAN: Verificar facturas borrador</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_draft_invoice_alerts()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=12, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
