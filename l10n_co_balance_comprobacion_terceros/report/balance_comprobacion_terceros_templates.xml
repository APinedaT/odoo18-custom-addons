<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="bct_report">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <h2>Balance de Comprobacion por Terceros</h2>

                    <div class="row mb-3">
                        <div class="col-4">
                            <strong>Compania:</strong>
                            <span t-esc="res_company.name"/>
                        </div>
                        <div class="col-4">
                            <strong>Fecha inicial:</strong>
                            <span t-esc="data['form']['date_from']"/>
                        </div>
                        <div class="col-4">
                            <strong>Fecha final:</strong>
                            <span t-esc="data['form']['date_to']"/>
                        </div>
                    </div>

                    <table class="table table-sm table-reports">
                        <thead>
                            <tr>
                                <th>Codigo Cuenta</th>
                                <th>Descripcion</th>
                                <th class="text-center">Ultimo Movimiento</th>
                                <th class="text-end">Saldo Anterior</th>
                                <th class="text-end">Debitos</th>
                                <th class="text-end">Creditos</th>
                                <th class="text-end">Nuevo Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lines" t-as="account_line">
                                <tr class="o_account_summary">
                                    <td>
                                        <strong t-esc="account_line['account_code']"/>
                                    </td>
                                    <td>
                                        <strong t-esc="account_line['account_name']"/>
                                    </td>
                                    <td class="text-center">
                                        <strong t-esc="account_line['last_move_date'] or ''"/>
                                    </td>
                                    <td class="text-end">
                                        <strong t-esc="account_line['previous_balance']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="text-end">
                                        <strong t-esc="account_line['debit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="text-end">
                                        <strong t-esc="account_line['credit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="text-end">
                                        <strong t-esc="account_line['new_balance']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                </tr>
                                <tr t-foreach="account_line['lines']" t-as="line">
                                    <td>
                                        <span t-esc="line['account_code']"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['description']"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="line['last_move_date'] or ''"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="line['previous_balance']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="line['debit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="line['credit']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="line['new_balance']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td colspan="4" class="text-end">
                                    <strong>Totales</strong>
                                </td>
                                <td class="text-end">
                                    <strong t-esc="total_debit" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td class="text-end">
                                    <strong t-esc="total_credit" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
